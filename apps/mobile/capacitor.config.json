{
  "appId": "app.kobling.mobile",
  "appName": "Kobling",
  "webDir": "../web/dist",
  "backgroundColor": "#eceef2",
  "server": {
    "androidScheme": "https",
    "cleartext": true
  },
  "android": {
    "allowMixedContent": true
  },
  "ios": {
    "contentInset": "never",
    "scrollEnabled": false
  },
  "plugins": {
    "Keyboard": { "resize": "native", "resizeOnFullScreen": true },
    "SystemBars": { "initialViewportFitValueHint": "cover" }
  }
}
