# Kobling server – miljøvariabler
# Generert av Kobling › Innstillinger
KOBLING_PORT=8080
KOBLING_PUBLIC_URL=
DUCKDNS_ENABLED=false
DUCKDNS_SUBDOMAIN=
DUCKDNS_TOKEN=
DUCKDNS_INTERVAL_MIN=5
DUCKDNS_IPV6=false
TLS_LETSENCRYPT=false
BACKUP_ENABLED=false
BACKUP_SMB_HOST=
BACKUP_SMB_SHARE=backup
BACKUP_SMB_PATH=kobling
BACKUP_SMB_USER=
BACKUP_SMB_PASS=
BACKUP_SMB_DOMAIN=WORKGROUP
BACKUP_SMB_VERSION=3.0
BACKUP_CRON=0 3 * * *
BACKUP_KEEP=14
BACKUP_INCLUDE=docs,figs,hist,users
SMTP_HOST=smtp.protonmail.ch
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
NOTIFY_COMMENTS=true
