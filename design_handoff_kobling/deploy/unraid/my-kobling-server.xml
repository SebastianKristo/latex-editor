<?xml version="1.0"?>
<Container version="2">
  <Name>kobling-server</Name>
  <Repository>ghcr.io/sebastiankristo/kobling-server:latest</Repository>
  <Registry>https://github.com/SebastianKristo/latex-editor/pkgs/container/kobling-server</Registry>
  <Network>bridge</Network>
  <MyIP/>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/SebastianKristo/latex-editor/issues</Support>
  <Project>https://github.com/SebastianKristo/latex-editor</Project>
  <Overview>Kobling: LaTeX-editor for elektrorapporter med kretsskjema-editor, sanntidssamarbeid, DuckDNS og backup til SMB-share.</Overview>
  <Category>Productivity: Tools:</Category>
  <WebUI>http://[IP]:[PORT:8080]/</WebUI>
  <Icon>https://raw.githubusercontent.com/SebastianKristo/latex-editor/main/deploy/unraid/icon.png</Icon>
  <ExtraParams/>
  <PostArgs/>
  <Config Name="Web-port" Target="8080" Default="8080" Mode="tcp" Description="Port for nettleser og Mac-app" Type="Port" Display="always" Required="true" Mask="false">8080</Config>
  <Config Name="HTTPS-port" Target="8443" Default="443" Mode="tcp" Description="Brukes når Let’s Encrypt er på" Type="Port" Display="advanced" Required="false" Mask="false">443</Config>
  <Config Name="Appdata" Target="/data" Default="/mnt/user/appdata/kobling" Mode="rw" Description="Dokumenter, figurer, database og lokale backuper" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/kobling</Config>
  <Config Name="Offentlig adresse" Target="KOBLING_PUBLIC_URL" Default="" Mode="" Description="Adressen brukerne kobler til" Type="Variable" Display="always" Required="false" Mask="false"></Config>
  <Config Name="DuckDNS aktiv" Target="DUCKDNS_ENABLED" Default="false" Mode="" Description="true eller false" Type="Variable" Display="always" Required="false" Mask="false">false</Config>
  <Config Name="DuckDNS subdomene" Target="DUCKDNS_SUBDOMAIN" Default="" Mode="" Description="Uten .duckdns.org" Type="Variable" Display="always" Required="false" Mask="false"></Config>
  <Config Name="DuckDNS token" Target="DUCKDNS_TOKEN" Default="" Mode="" Description="Fra duckdns.org" Type="Variable" Display="always" Required="false" Mask="true"></Config>
  <Config Name="DuckDNS intervall (min)" Target="DUCKDNS_INTERVAL_MIN" Default="5" Mode="" Description="Hvor ofte IP-adressen oppdateres" Type="Variable" Display="advanced" Required="false" Mask="false">5</Config>
  <Config Name="DuckDNS IPv6" Target="DUCKDNS_IPV6" Default="false" Mode="" Description="Oppdater også AAAA-post" Type="Variable" Display="advanced" Required="false" Mask="false">false</Config>
  <Config Name="Let’s Encrypt" Target="TLS_LETSENCRYPT" Default="false" Mode="" Description="Sertifikat via DuckDNS DNS-01" Type="Variable" Display="always" Required="false" Mask="false">false</Config>
  <Config Name="Backup aktiv" Target="BACKUP_ENABLED" Default="false" Mode="" Description="true eller false" Type="Variable" Display="always" Required="false" Mask="false">false</Config>
  <Config Name="SMB-server" Target="BACKUP_SMB_HOST" Default="" Mode="" Description="Vertsnavn eller IP, f.eks. 192.168.1.10" Type="Variable" Display="always" Required="false" Mask="false"></Config>
  <Config Name="SMB-share" Target="BACKUP_SMB_SHARE" Default="backup" Mode="" Description="Navnet på sharen" Type="Variable" Display="always" Required="false" Mask="false">backup</Config>
  <Config Name="Mappe i share" Target="BACKUP_SMB_PATH" Default="kobling" Mode="" Description="Undermappe for Kobling" Type="Variable" Display="always" Required="false" Mask="false">kobling</Config>
  <Config Name="SMB-bruker" Target="BACKUP_SMB_USER" Default="" Mode="" Description="Bruker med skrivetilgang" Type="Variable" Display="always" Required="false" Mask="false"></Config>
  <Config Name="SMB-passord" Target="BACKUP_SMB_PASS" Default="" Mode="" Description="Passord for SMB-brukeren" Type="Variable" Display="always" Required="false" Mask="true"></Config>
  <Config Name="SMB-domene" Target="BACKUP_SMB_DOMAIN" Default="WORKGROUP" Mode="" Description="Domene eller arbeidsgruppe" Type="Variable" Display="advanced" Required="false" Mask="false">WORKGROUP</Config>
  <Config Name="SMB-versjon" Target="BACKUP_SMB_VERSION" Default="3.0" Mode="" Description="2.1, 3.0 eller 3.1.1" Type="Variable" Display="advanced" Required="false" Mask="false">3.0</Config>
  <Config Name="Backup-tidsplan (cron)" Target="BACKUP_CRON" Default="0 3 * * *" Mode="" Description="Standard: hver natt kl. 03:00" Type="Variable" Display="always" Required="false" Mask="false">0 3 * * *</Config>
  <Config Name="Antall backuper" Target="BACKUP_KEEP" Default="14" Mode="" Description="Eldre backuper slettes" Type="Variable" Display="always" Required="false" Mask="false">14</Config>
  <Config Name="Innhold" Target="BACKUP_INCLUDE" Default="docs,figs,hist,users" Mode="" Description="docs,figs,hist,users" Type="Variable" Display="advanced" Required="false" Mask="false">docs,figs,hist,users</Config>
  <Config Name="SMTP-server" Target="SMTP_HOST" Default="smtp.protonmail.ch" Mode="" Description="Proton Mail: smtp.protonmail.ch (port 587, STARTTLS, bruker = adressen, passord = SMTP-token)" Type="Variable" Display="always" Required="false" Mask="false">smtp.protonmail.ch</Config>
  <Config Name="SMTP-port" Target="SMTP_PORT" Default="587" Mode="" Description="587 (STARTTLS) eller 465 (SSL)" Type="Variable" Display="always" Required="false" Mask="false">587</Config>
  <Config Name="SMTP-sikkerhet" Target="SMTP_SECURITY" Default="starttls" Mode="" Description="starttls, ssl eller none" Type="Variable" Display="advanced" Required="false" Mask="false">starttls</Config>
  <Config Name="SMTP-bruker" Target="SMTP_USER" Default="" Mode="" Description="Brukernavn hos e-postleverandøren" Type="Variable" Display="always" Required="false" Mask="false"></Config>
  <Config Name="SMTP-passord" Target="SMTP_PASS" Default="" Mode="" Description="App-passord anbefales" Type="Variable" Display="always" Required="false" Mask="true"></Config>
  <Config Name="Avsender" Target="SMTP_FROM" Default="" Mode="" Description="F.eks. Kobling &lt;kobling@mitt-navn.duckdns.org&gt;" Type="Variable" Display="always" Required="false" Mask="false"></Config>
  <Config Name="Varsle om kommentarer" Target="NOTIFY_COMMENTS" Default="true" Mode="" Description="Send e-post ved nye kommentarer" Type="Variable" Display="advanced" Required="false" Mask="false">true</Config>
</Container>
